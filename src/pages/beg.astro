---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { landingA } from '../content/landing-a';
import { landingB } from '../content/landing-b';
import { standaloneNav } from '../content/nav';
import Landing from '../layouts/Landing.astro';

/**
 * Развилка направления «Бег».
 *
 * Раньше стояла на корне сайта. Корень занял хаб всех направлений Федерации,
 * а развилка осталась нужна: у бега две разные аудитории и два разных
 * разговора, и вести рекламный трафик на общий хаб — терять сегмент.
 */
const meta = {
  title: 'Бег — онлайн-гайд по естественной технике',
  description:
    'Два пути к одному гайду: «Комфортный бег» — если хотите бегать легко и в удовольствие, «Сила и выносливость» — если уже тренируетесь и хотите встроить бег в план.',
  ogImage: '/img/silhouettes.jpg',
};

const options = [
  {
    href: '/komfort/',
    image: landingA.hero.image,
    brand: landingA.brand,
    title: 'Хочу бегать легко и в удовольствие',
    text: 'Четыре привычки, из которых складывается комфорт, и техника, которая их ставит. Спокойно, без километров через силу.',
  },
  {
    href: '/sila/',
    image: landingB.hero.image,
    brand: landingB.brand,
    title: 'Хочу выносливость, не потеряв силу',
    text: 'Механика шага по фазам и план на 21 день, чтобы бег работал на силовую, а не против неё.',
  },
];
---

<Landing meta={meta} path="/beg/">
  <SiteHeader brand="Бег" nav={standaloneNav} segment="beg" />

  <main class="chooser">
    <div class="chooser__intro container">
      <p class="kicker">Направление · онлайн-гайд по естественной технике</p>
      <h1 class="chooser__title">С чего у вас начинается бег?</h1>
      <p class="chooser__lead">Гайд один, разговор разный. Выберите ситуацию, которая ближе.</p>
    </div>

    <div class="chooser__grid container">
      {
        options.map((option) => (
          <a class="option" href={option.href}>
            <img class="option__image" src={option.image} alt="" aria-hidden="true" />
            <span class="option__scrim" />
            <span class="option__body">
              <span class="option__brand">{option.brand}</span>
              <span class="option__title">{option.title}</span>
              <span class="option__text">{option.text}</span>
              <span class="option__action">Смотреть →</span>
            </span>
          </a>
        ))
      }
    </div>
  </main>

  <SiteFooter />
</Landing>

<style>
  .chooser {
    display: flex;
    flex-direction: column;
    gap: 48px;
    padding-block: 64px;
  }

  .chooser__intro {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .chooser__title {
    font-family: var(--font-display);
    font-size: clamp(34px, 5.4vw, 64px);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .chooser__lead {
    font-size: clamp(18px, 2.2vw, 24px);
    line-height: 1.45;
    color: var(--text-lead);
    max-width: 46ch;
  }

  .chooser__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 28px;
  }

  .option {
    position: relative;
    display: block;
    min-height: 420px;
    overflow: hidden;
    border: 1px solid var(--border-soft);
    color: var(--text);
  }

  .option:hover {
    border-color: var(--accent-text);
    color: var(--text);
  }

  .option__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(1.04);
    transition: transform 300ms ease;
  }

  .option:hover .option__image {
    transform: scale(1.03);
  }

  .option__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(247, 242, 231, 0) 0%,
      rgba(247, 242, 231, 0.6) 38%,
      rgba(247, 242, 231, 0.99) 60%
    );
  }

  .option__body {
    position: absolute;
    inset: auto 0 0 0;
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .option__brand {
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent-text);
  }

  .option__title {
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 800;
    line-height: 1.1;
    /* Заголовок карточки — не heading, поэтому глобальное правило его
       не покрывает: балансируем строки здесь, иначе предлог повисает. */
    text-wrap: balance;
  }

  .option__text {
    font-size: 17px;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  .option__action {
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 800;
    color: var(--accent-text);
    padding-top: 8px;
  }
</style>
