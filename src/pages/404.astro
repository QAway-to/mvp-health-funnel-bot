---
import Landing from '../layouts/Landing.astro';

/**
 * Собирается в `dist/404.html`. Render отдаёт его на несуществующие адреса,
 * поэтому обычная опечатка в ссылке не приводит на пустую страницу хостинга.
 */
const meta = {
  title: 'Страница не найдена',
  description: 'Такой страницы нет. Выберите один из двух лендингов гайда по бегу.',
  ogImage: '/img/silhouettes.jpg',
};
---

<Landing meta={meta} path="/404/">
  <main class="notfound">
    <div class="container notfound__inner">
      <p class="kicker">Ошибка 404</p>
      <h1 class="notfound__title">Такой страницы нет</h1>
      <p class="notfound__lead">
        Возможно, ссылка устарела или в адресе опечатка. Гайд по-прежнему на месте — выберите
        подходящий разговор.
      </p>

      <div class="notfound__actions">
        <a class="btn btn--primary btn--lg" href="/komfort/">Комфортный бег</a>
        <a class="btn btn--ghost btn--lg" href="/sila/">Бег как сила</a>
      </div>
    </div>
  </main>
</Landing>

<style>
  .notfound {
    min-height: 100vh;
    display: flex;
    align-items: center;
  }

  .notfound__inner {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding-block: 80px;
  }

  .notfound__title {
    font-family: var(--font-display);
    font-size: clamp(34px, 5.4vw, 64px);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .notfound__lead {
    font-size: clamp(18px, 2.2vw, 24px);
    line-height: 1.45;
    color: var(--text-lead);
    max-width: 46ch;
  }

  .notfound__actions {
    display: flex;
    gap: 18px;
    flex-wrap: wrap;
    padding-top: 8px;
  }
</style>
