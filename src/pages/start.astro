---
import Cta from '../components/Cta.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { site, routes } from '../config/site';
import { leadMagnet } from '../content/lead';
import { standaloneNav } from '../content/nav';
import { botUrl } from '../lib/leadLink';
import { isFilled } from '../lib/offer';
import Landing from '../layouts/Landing.astro';

/**
 * Бесплатная ступень воронки.
 *
 * Формы на странице нет: заявка уходит в Telegram-бот
 * (`site.lead.destination === 'telegram_bot'`), поэтому сайт остаётся
 * статикой — не нужен бэкенд и не хранятся персональные данные.
 */

const meta = {
  title: 'Первый шаг бесплатно — чек-лист и ответы в Telegram',
  description:
    'Бесплатная ступень Федерации здоровья: чек-лист, ответы по материалам направлений и короткий разбор по вашей теме. Без оплаты.',
  ogImage: '/img/barefoot-step.jpg',
};

const hasBot = isFilled(site.lead.telegramUrl);
/**
 * Ссылка на бота с меткой источника. Здесь стоит метка по умолчанию: страницу
 * открывают и напрямую. Если человек пришёл с продуктового лендинга, адрес
 * несёт `?s=<сегмент>`, и скрипт внизу подменяет метку на его собственную —
 * до клика, так что в бота уезжает именно она.
 */
const botLink = botUrl(site.lead.telegramUrl);
---

<Landing meta={meta} path={routes.start}>
  <SiteHeader brand={site.brand} nav={standaloneNav} showCta={false} />

  <main class="start">
    <div class="container start__inner">
      <p class="kicker">{leadMagnet.kicker}</p>
      <h1 class="start__title">{leadMagnet.title}</h1>
      <p class="start__lead">{leadMagnet.lead}</p>

      <ul class="start__points">
        {leadMagnet.points.map((point) => <li class="start__point">{point}</li>)}
      </ul>

      <div class="start__action">
        {
          hasBot ? (
            <Cta kind="primary" href={botLink} placement="start_page">
              Забрать в Telegram
            </Cta>
          ) : (
            <p class="start__todo">
              Ссылка на Telegram-бот пока не задана. Укажите её в <code>src/config/site.ts</code> →
              <code>lead.telegramUrl</code>, и кнопка появится.
            </p>
          )
        }

        <p class="start__note">Бесплатно и без оплаты. Отписаться можно в одно нажатие.</p>
        <p class="start__scope">{leadMagnet.scope}</p>
      </div>

      <p class="start__back">
        Уже понимаете, чего хотите? <a href={routes.home}>Все направления</a> —
        бег, сон, закаливание, вредные привычки, зарядка, самомассаж и массаж.
      </p>
    </div>
  </main>

  <SiteFooter />
</Landing>

<script>
  import { botUrl } from '../lib/leadLink';

  import { track } from '../scripts/track';

  /**
   * Переносим сегмент из адреса страницы в deep link бота.
   *
   * Страница статическая и раздаётся всем одна и та же, поэтому сегмент
   * известен только в браузере. Подмена происходит сразу при загрузке, а не по
   * клику: клик по ссылке в Telegram может обработаться раньше обработчика.
   *
   * Значение проверяется по закрытому списку внутри `botUrl` — в чужой домен
   * не должно уехать ничего, чего мы сами не заводили.
   */
  const link = document.querySelector<HTMLAnchorElement>('a[data-cta="start_page"]');
  const segment = new URLSearchParams(window.location.search).get('s');

  if (link && segment) {
    link.href = botUrl(link.href, segment);
  }

  /* Заявка = уход в бота. Дальше человек уже вне сайта, и это последнее
     событие, которое мы можем снять: без него воронка обрывается на переходе. */
  link?.addEventListener('click', () => {
    track('lead_submitted', { segment: segment ?? 'site' });
  });
</script>

<style>
  .start {
    min-height: 100vh;
    display: flex;
    align-items: center;
  }

  .start__inner {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding-block: 72px;
    max-width: 760px;
  }

  .start__title {
    font-family: var(--font-display);
    font-size: clamp(34px, 5.4vw, 60px);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .start__lead {
    font-size: clamp(18px, 2.2vw, 24px);
    line-height: 1.45;
    color: var(--text-lead);
  }

  .start__points {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .start__point {
    position: relative;
    padding-left: 22px;
    font-size: 17px;
    line-height: 1.55;
    color: var(--text-card);
  }

  .start__point::before {
    content: '';
    position: absolute;
    left: 0;
    top: 10px;
    width: 8px;
    height: 8px;
    background: var(--accent);
  }

  .start__action {
    display: flex;
    flex-direction: column;
    gap: 12px;
    align-items: flex-start;
    padding-top: 8px;
  }

  .start__note,
  .start__back {
    font-size: 16px;
    color: var(--text-muted);
  }

  /* Что бот умеет сегодня: строка про границы должна читаться, но не спорить
     с обещанием — поэтому уже колонки и приглушённее основного текста. */
  .start__scope {
    font-size: 15px;
    line-height: 1.55;
    color: var(--text-muted);
    max-width: 52ch;
  }

  .start__todo {
    border-left: 3px solid var(--accent-problem);
    border-radius: 0;
    padding: 12px 16px;
    background: var(--card-secondary);
    font-size: 16px;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  .start__todo code {
    color: var(--accent-text);
  }
</style>
