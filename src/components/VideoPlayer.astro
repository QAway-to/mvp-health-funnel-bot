---
import { parseVideoUrl, youtubeEmbedUrl } from '../lib/video';

/**
 * Плеер демо-урока.
 *
 * YouTube подключается через фасад: до клика на странице лежит только постер
 * и кнопка, а iframe создаётся уже по нажатию. Встроенный сразу, он тянет
 * около 700 КБ скриптов на каждой загрузке страницы и роняет LCP — а у нас
 * бюджет 2.5s.
 *
 * Если ссылки нет, вместо плеера показывается заглушка с указанием, что вписать.
 */

interface Props {
  /** Значение `site.demo.videoUrl`: ссылка YouTube или путь к файлу. */
  url: string;
  /** Картинка-превью из `public/`. */
  poster: string;
  /** Подпись для скринридера и кнопки. */
  title: string;
}

const { url, poster, title } = Astro.props;

const source = parseVideoUrl(url);
const embedUrl = source.kind === 'youtube' ? youtubeEmbedUrl(source.id, true) : '';
const vertical = source.kind === 'youtube' && source.vertical;
---

<div class:list={['player', vertical && 'player--vertical']}>
  {
    source.kind === 'file' && (
      <video
        class="player__video"
        src={source.src}
        poster={poster}
        controls
        preload="none"
        playsinline
        data-video-file
      >
        Ваш браузер не умеет проигрывать это видео.
      </video>
    )
  }

  {
    source.kind === 'youtube' && (
      <button class="player__facade" type="button" data-video-facade data-embed={embedUrl}>
        <img class="player__poster" src={poster} alt="" aria-hidden="true" loading="lazy" />
        <span class="player__scrim" />
        <span class="player__play" aria-hidden="true" />
        <span class="player__label">Смотреть урок{title ? `: ${title}` : ''}</span>
      </button>
    )
  }

  {
    source.kind === 'none' && (
      <div class="player__empty">
        <img class="player__poster" src={poster} alt="" aria-hidden="true" loading="lazy" />
        <p class="player__empty-text">
          Здесь будет видео урока. Вставьте ссылку с YouTube или путь к файлу в
          <code>src/config/site.ts</code> → <code>demo.videoUrl</code>.
        </p>
      </div>
    )
  }
</div>

<style>
  .player {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--card-primary);
    border: 1px solid var(--border-soft);
    overflow: hidden;
  }

  /* Shorts вертикальные — 16:9 обрезал бы их по бокам. */
  .player--vertical {
    aspect-ratio: 9 / 16;
    max-width: 420px;
    margin-inline: auto;
  }

  .player__video,
  .player__poster {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .player__video {
    background: #000;
  }

  .player__facade,
  .player__empty {
    position: absolute;
    inset: 0;
    padding: 0;
    border: 0;
    background: none;
    width: 100%;
    height: 100%;
  }

  .player__facade {
    cursor: pointer;
  }

  .player__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(28, 24, 16, 0.15), rgba(28, 24, 16, 0.45));
    transition: background 150ms ease;
  }

  .player__facade:hover .player__scrim {
    background: linear-gradient(180deg, rgba(28, 24, 16, 0.25), rgba(28, 24, 16, 0.55));
  }

  /* Треугольник рисуем границами: одним элементом, без иконочного шрифта. */
  .player__play {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 84px;
    height: 84px;
    border-radius: 50%;
    background: var(--accent);
    transition: transform 150ms ease;
  }

  .player__play::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 54%;
    transform: translate(-50%, -50%);
    border-style: solid;
    border-width: 15px 0 15px 24px;
    border-color: transparent transparent transparent var(--on-accent);
  }

  .player__facade:hover .player__play {
    transform: translate(-50%, -50%) scale(1.06);
  }

  .player__facade:focus-visible {
    outline: 3px solid var(--accent-hover);
    outline-offset: -3px;
  }

  .player__label {
    position: absolute;
    inset: auto 20px 20px 20px;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 17px;
    color: #fff;
    text-align: left;
  }

  .player__empty-text {
    position: absolute;
    inset: auto 24px 24px 24px;
    font-size: 16px;
    line-height: 1.55;
    color: #fff;
    text-shadow: 0 1px 12px rgba(28, 24, 16, 0.9);
  }

  .player__empty-text code {
    color: var(--accent);
  }

  .player__empty .player__poster {
    filter: brightness(0.55);
  }

  /* Плеер, вставленный после клика */
  .player :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>

<script>
  import { track } from '../scripts/track';

  const facade = document.querySelector<HTMLButtonElement>('[data-video-facade]');

  facade?.addEventListener(
    'click',
    () => {
      const embed = facade.dataset.embed;
      if (!embed) return;

      const iframe = document.createElement('iframe');
      iframe.src = embed;
      iframe.title = 'Демо-урок';
      iframe.allow = 'accelerometer; autoplay; encrypted-media; picture-in-picture; fullscreen';
      iframe.allowFullscreen = true;

      facade.replaceWith(iframe);
      track('demo_played', { source: 'youtube' });
    },
    { once: true },
  );

  document.querySelector<HTMLVideoElement>('[data-video-file]')?.addEventListener(
    'play',
    () => track('demo_played', { source: 'file' }),
    { once: true },
  );
</script>
