---
import type { Effects } from '../content/types';

interface Props {
  effects: Effects;
  tone: 'base' | 'alt';
}

const { effects, tone } = Astro.props;
---

<section class={`section section--${tone}`} data-section="effects">
  <div class="container stack">
    <p class="kicker">{effects.kicker}</p>
    <h2 class="h2 effects__title">{effects.title}</h2>

    <div class="effects__grid">
      {
        effects.items.map((item) => (
          <article class="effects__item">
            <h3 class="effects__item-title">{item.title}</h3>
            <p class="rule-card__text">{item.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .effects__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 28px;
  }

  .effects__item {
    border-top: 3px solid var(--accent);
    padding-top: 18px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .effects__item-title {
    font-family: var(--font-display);
    font-size: 23px;
    font-weight: 800;
    line-height: 1.1;
  }
</style>
