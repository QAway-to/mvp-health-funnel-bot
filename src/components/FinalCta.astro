---
import Cta from './Cta.astro';
import type { FinalCta } from '../content/types';

interface Props {
  finalCta: FinalCta;
}

const { finalCta } = Astro.props;
---

<section class="final" data-section="final">
  <img
    class="final__image"
    src={finalCta.image}
    alt=""
    aria-hidden="true"
    loading="lazy"
    decoding="async"
    style={`filter: brightness(${finalCta.imageBrightness})`}
  />
  <div class="final__scrim"></div>

  <div class="final__inner container">
    <h2 class="final__title">{finalCta.title}</h2>
    <p class="final__lead">{finalCta.lead}</p>

    <div class="final__actions">
      <Cta kind="sales" href={finalCta.href} placement="final">{finalCta.ctaLabel}</Cta>
      <p class="final__note">{finalCta.note}</p>
    </div>
  </div>
</section>

<style>
  .final {
    position: relative;
    overflow: hidden;
  }

  .final__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .final__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      88deg,
      rgba(6, 6, 5, 0.96) 0%,
      rgba(6, 6, 5, 0.9) 55%,
      rgba(6, 6, 5, 0.6) 100%
    );
  }

  .final__inner {
    position: relative;
    padding-block: 96px;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .final__title {
    font-family: var(--font-display);
    font-size: clamp(34px, 5.4vw, 68px);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.03em;
    max-width: 20ch;
  }

  .final__lead {
    font-size: clamp(18px, 2.2vw, 24px);
    line-height: 1.45;
    color: var(--text-lead);
    max-width: 48ch;
  }

  .final__actions {
    display: flex;
    gap: 18px;
    flex-wrap: wrap;
    align-items: center;
  }

  .final__note {
    font-size: 17px;
    color: var(--text-muted);
  }
</style>
