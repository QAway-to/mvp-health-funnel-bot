---
import DirectionsGrid from '../components/DirectionsGrid.astro';
import DirectionsSoon from '../components/DirectionsSoon.astro';
import HubIntro from '../components/HubIntro.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Subscription from '../components/Subscription.astro';
import Testimonials from '../components/Testimonials.astro';
import { site } from '../config/site';
import { ctaLabels } from '../content/cta';
import { directions, liveDirections, soonDirections } from '../content/directions';
import { hubNav } from '../content/nav';
import { testimonialsFor } from '../content/testimonials';
import { startUrl } from '../lib/leadLink';
import Landing from '../layouts/Landing.astro';

/**
 * Хаб направлений — пункт плана П14 («мини-сайт на все продукты»).
 *
 * Раньше на корне стояла развилка двух беговых лендингов. Бег переехал на
 * `/beg/`, а корень собирает все направления Федерации: и открытые, и те,
 * что заявлены планом и ещё готовятся.
 *
 * Список берётся из реестра, а не пишется здесь руками: открылось
 * направление — карточка появилась и на главной, и в блоке подписки. Сама
 * вёрстка карточек с 03.09.2026 живёт в `DirectionsGrid`/`DirectionsSoon` —
 * её делит с английской главной, чтобы у двух версий сайта не разъехалась
 * одна и та же сетка.
 */
const meta = {
  title: 'Федерация здоровья — направления здорового образа жизни',
  description:
    'Бег, сон, закаливание, вредные привычки, зарядка, массаж и самомассаж — и ещё четыре направления в работе. Одна подписка на всё, первый шаг бесплатно.',
  ogImage: '/img/silhouettes.jpg',
};

const liveCount = liveDirections.length;
const totalCount = directions.length;

/**
 * Склонение слова «направление» под число.
 *
 * Раньше в заголовке стояло «Ещё 6 направлений» жёстким текстом, и это
 * работало ровно до того дня, когда готовящихся стало четыре. Числа берутся
 * из реестра, значит и форма слова должна браться оттуда же.
 */
const directionWord = (count: number): string => {
  const tail = count % 100;
  if (tail >= 11 && tail <= 14) return 'направлений';
  switch (count % 10) {
    case 1:
      return 'направление';
    case 2:
    case 3:
    case 4:
      return 'направления';
    default:
      return 'направлений';
  }
};

/* Тон следующей секции зависит от того, покажутся ли отзывы: иначе два
   одинаковых фона встанут подряд. */
const hasTestimonials = testimonialsFor('all').length > 0;
---

<Landing meta={meta} path="/">
  <SiteHeader brand={site.brand} nav={hubNav} segment="home" />

  <main>
    <HubIntro
      kicker="Федерация здоровья"
      title="Здоровье собирается из привычек, а не из курсов"
      lead="Сон тянет за собой утро, утро — нагрузку, нагрузка — восстановление. Поэтому направлений десять, а подписка одна: браться за них по очереди можно, покупать по отдельности — незачем."
      primary={{ label: ctaLabels.free, href: startUrl('home'), placement: 'hub_hero' }}
      secondary={{ label: 'Смотреть направления', href: '#directions', placement: 'hub_directions' }}
    />

    <DirectionsGrid
      tone="alt"
      kicker="Направления"
      heading={`Открыто ${liveCount} из ${totalCount}`}
      action="Смотреть"
    />

    <DirectionsSoon
      tone="base"
      kicker="Готовятся"
      heading={`Ещё ${soonDirections.length} ${directionWord(soonDirections.length)} в работе`}
      lede="Они заявлены в плане Федерации и откроются подписчикам без доплаты. Порядок зависит от того, чего просят чаще: написать об этом можно в боте."
      pagesNote="У части из них страница уже готова — материал дописывается."
    />

    {hasTestimonials && <Testimonials tone="alt" segment="all" />}

    <Subscription tone={hasTestimonials ? 'base' : 'alt'} segment="home" />
  </main>

  <SiteFooter />
</Landing>

<style>
  /* Первый экран и сетки направлений живут в своих компонентах: страница
     осталась сборкой, а не вёрсткой. */
</style>
