---
import Cta from '../../components/Cta.astro';
import DirectionsGrid from '../../components/DirectionsGrid.astro';
import DirectionsSoon from '../../components/DirectionsSoon.astro';
import Faq from '../../components/Faq.astro';
import FinalCta from '../../components/FinalCta.astro';
import HubIntro from '../../components/HubIntro.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import StickyCta from '../../components/StickyCta.astro';
import Subscription from '../../components/Subscription.astro';
import Testimonials from '../../components/Testimonials.astro';
import { site } from '../../config/site';
import { testimonialsFor } from '../../content/testimonials';
import { enFaq, enFinalCta, enHome } from '../../content/en/home';
import { liveDirectionsFor, soonDirectionsFor, directionsCountFor } from '../../i18n/content';
import { botUrl, freeStepUrl } from '../../lib/leadLink';
import Landing from '../../layouts/Landing.astro';

/**
 * Английская главная — тот же сайт, а не его витрина.
 *
 * ЧТО БЫЛО ДО 03.09.2026. Одна страница на четыре блока: заголовок, метод,
 * шесть неактивных карточек, три цены строкой. Карточки не были ссылками,
 * хотя страницы направлений уже существовали; купить со страницы было
 * нельзя; отзывов, вопросов и последнего экрана не было вовсе. Человек,
 * пришедший по ссылке из письма к инструктору холодовых практик, упирался
 * в текст и уходил.
 *
 * ЧТО ЗДЕСЬ СЕЙЧАС. Те же секции, что и на русской главной, и собраны они из
 * тех же компонентов: сетка направлений, готовящиеся темы, отзывы, подписка
 * с обеими кнопками оплаты, вопросы, последний экран. Отличается текст —
 * он написан под другого читателя, — и один блок сверх русской версии: про
 * язык материала. Он стоит дважды, потому что это единственное, о чём тут
 * нельзя умолчать.
 */

const liveCount = liveDirectionsFor('en').length;
const totalCount = directionsCountFor('en');
const soonCount = soonDirectionsFor('en').length;

const botLink = botUrl(site.lead.telegramUrl);
const freeLink = freeStepUrl('home', 'en');

/* Отзывов по-английски может не оказаться: непереведённые не показываются.
   Тон следующей секции считается по факту, а не по надежде. */
const hasTestimonials = testimonialsFor('all', 'en').length > 0;
---

<Landing meta={enHome.meta} path="/en/">
  <SiteHeader brand={enHome.brand} nav={[]} segment="home" />

  <main>
    <HubIntro
      kicker={enHome.hero.eyebrow}
      title={enHome.hero.heading}
      lead={enHome.hero.lede}
      note={enHome.hero.note}
      primary={{ label: enHome.start.button, href: freeLink, placement: 'hub_hero' }}
      secondary={{
        label: enHome.hero.secondary,
        href: '#directions',
        placement: 'hub_directions',
      }}
    />

    <section class="section section--alt" data-section="method">
      <div class="container prose">
        <h2 class="h2">{enHome.method.heading}</h2>
        {enHome.method.paragraphs.map((text) => <p class="prose__text">{text}</p>)}
      </div>
    </section>

    <DirectionsGrid
      tone="base"
      kicker={enHome.directions.kicker}
      heading={enHome.directions.heading(liveCount, totalCount)}
      action={enHome.directions.cardAction}
      stepsLabel={enHome.directions.stepsLabel}
    />

    <DirectionsSoon
      tone="alt"
      kicker={enHome.soon.kicker}
      heading={enHome.soon.heading(soonCount)}
      lede={enHome.soon.lede}
    />

    {hasTestimonials && <Testimonials tone="base" segment="all" />}

    {/* Блок о языке стоит ПЕРЕД ценой. Человек должен прочитать, на каком
        языке материал, до того, как увидит сумму, — а не после. То же
        предупреждение повторяется внутри блока подписки. */}
    <section class={`section section--${hasTestimonials ? 'alt' : 'base'}`} data-section="language">
      <div class="container prose">
        <h2 class="h2">{enHome.language.heading}</h2>
        <p class="prose__text">{enHome.language.text}</p>
        <Cta kind="secondary" href={botLink} placement="language">{enHome.language.cta}</Cta>
      </div>
    </section>

    <Subscription tone={hasTestimonials ? 'base' : 'alt'} segment="home" />

    <Faq faq={enFaq} tone="alt" />

    <FinalCta finalCta={enFinalCta} segment="home" />
  </main>

  <StickyCta segment="home" />

  <SiteFooter />
</Landing>

<style>
  /* Колонка текста: та же ширина, что у остальных читаемых блоков сайта. */
  .prose {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    max-width: 760px;
  }

  .prose__text {
    font-size: 18px;
    line-height: 1.65;
    color: var(--text-lead);
  }
</style>
