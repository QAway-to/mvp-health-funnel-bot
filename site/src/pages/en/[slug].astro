---
import Cta from '../../components/Cta.astro';
import Faq from '../../components/Faq.astro';
import FinalCta from '../../components/FinalCta.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import StickyCta from '../../components/StickyCta.astro';
import Subscription from '../../components/Subscription.astro';
import Testimonials from '../../components/Testimonials.astro';
import { directions } from '../../content/directions';
import { enDirections, type EnDirectionPage } from '../../content/en/directions';
import { enFaq, enHome } from '../../content/en/home';
import { testimonialsFor } from '../../content/testimonials';
import { freeStepUrl } from '../../lib/leadLink';
import Landing from '../../layouts/Landing.astro';

/**
 * Английская страница направления.
 *
 * Одна на все шесть: структура у них общая, различается содержание. Шесть
 * почти одинаковых файлов разошлись бы на первой же правке — и разошлись бы
 * тихо, потому что смотреть их все никто не станет.
 *
 * Картинка берётся из русского реестра направлений по слагу: адреса совпадают,
 * значит и фон должен совпадать. Человек, переключивший язык, должен узнать
 * страницу, а не решить, что попал в другое место.
 *
 * С 03.09.2026 страница дописана до конца: раньше она обрывалась списком цен
 * без кнопок — прочитать было что, а купить нечего. Теперь после состава идут
 * отзывы, полный блок подписки с обеими кнопками оплаты, вопросы и последний
 * экран, ровно как на русской странице направления.
 */

export function getStaticPaths() {
  return enDirections.map((direction) => ({
    params: { slug: direction.slug },
    props: { direction },
  }));
}

interface Props {
  direction: EnDirectionPage;
}

const { direction } = Astro.props;

const russian = directions.find((item) => item.slug === direction.slug);
const image = russian?.image ?? '/img/mountain.jpg';

const meta = {
  title: `${direction.title} — Federation of Health`,
  description: direction.promise,
  ogImage: image,
};

const freeLink = freeStepUrl(direction.slug, 'en');

/* Отзыв по направлению может быть, а может и не быть — и по-английски реже,
   чем по-русски: непереведённые не показываются. */
const hasTestimonials = testimonialsFor(direction.slug, 'en').length > 0;

/** Последний экран собирается из обещания направления, а не из общего текста. */
const finalCta = {
  title: 'Take the first step today',
  lead: direction.promise,
  note: 'The first step is free and asks for nothing — no card, no form.',
  image,
  imageBrightness: 0.5,
};
---

<Landing meta={meta} path={`/en/${direction.slug}/`}>
  <SiteHeader brand={enHome.brand} nav={[]} segment={direction.slug} />

  <main>
    <section
      class="dir__hero"
      style={`background-image: linear-gradient(to right, rgba(20,18,13,.86), rgba(20,18,13,.55)), url('${image}')`}
      data-section="hero"
    >
      <div class="container dir__hero-inner">
        <p class="dir__eyebrow">{enHome.directions.stepsLabel(direction.steps.length)}</p>
        <h1 class="dir__heading">{direction.title}</h1>
        <p class="dir__promise">{direction.promise}</p>
        <div class="dir__hero-actions">
          <Cta kind="primary" href={freeLink} placement="hero">{enHome.start.button}</Cta>
        </div>
      </div>
    </section>

    <section class="container dir__inner" data-section="angle">
      <p class="dir__angle">{direction.angle}</p>
      {direction.body.map((text) => <p class="dir__text">{text}</p>)}
    </section>

    <section class="dir__band" data-section="steps">
      <div class="container dir__inner">
        <h2 class="dir__title">What the steps cover</h2>
        <ol class="dir__steps">
          {direction.steps.map((step) => <li class="dir__step">{step}</li>)}
        </ol>
        <p class="dir__note">
          Each step is a short clip and the dose in text — how much, in what
          order, and what not to do.
        </p>
      </div>
    </section>

    <section class="container dir__inner" data-section="not_for">
      <h2 class="dir__title">Who this is not for</h2>
      <p class="dir__text">{direction.notFor}</p>
    </section>

    {hasTestimonials && <Testimonials tone="alt" segment={direction.slug} />}

    <Subscription tone={hasTestimonials ? 'base' : 'alt'} segment={direction.slug} />

    <Faq faq={enFaq} tone="base" />

    <FinalCta finalCta={finalCta} segment={direction.slug} />
  </main>

  <StickyCta segment={direction.slug} />

  <SiteFooter />
</Landing>

<style>
  .dir__hero {
    background-size: cover;
    background-position: center;
    color: #f7f2e7;
  }

  .dir__hero-inner {
    padding: clamp(64px, 11vw, 132px) 0;
    max-width: 760px;
  }

  .dir__hero-actions {
    margin-top: 30px;
  }

  .dir__eyebrow {
    margin: 0 0 14px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }

  .dir__heading {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(34px, 6vw, 58px);
    font-weight: 800;
    line-height: 1.06;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .dir__promise {
    margin: 20px 0 0;
    font-size: clamp(17px, 2vw, 20px);
    max-width: 46ch;
    color: rgba(247, 242, 231, 0.86);
  }

  .dir__inner {
    max-width: 760px;
    padding-block: clamp(44px, 7vw, 76px);
  }

  .dir__band {
    background: var(--bg-alt);
  }

  .dir__angle {
    margin: 0 0 22px;
    font-size: clamp(18px, 2.2vw, 21px);
    font-family: var(--font-display);
    font-weight: 500;
    line-height: 1.45;
    color: var(--text);
    max-width: 54ch;
    text-wrap: balance;
  }

  .dir__text {
    margin: 0 0 14px;
    color: var(--text-lead);
    max-width: 62ch;
    line-height: 1.65;
  }

  .dir__title {
    margin: 0 0 18px;
    font-family: var(--font-display);
    font-size: clamp(22px, 3vw, 28px);
    font-weight: 700;
    letter-spacing: -0.015em;
  }

  .dir__steps {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
    display: grid;
    gap: 1px;
    background: var(--border-hairline);
    border: 1px solid var(--border-soft);
  }

  .dir__step {
    counter-increment: step;
    background: var(--card-secondary);
    padding: 13px 18px 13px 52px;
    position: relative;
    color: var(--text-card);
  }

  .dir__step::before {
    content: counter(step);
    position: absolute;
    left: 18px;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 13px;
    color: var(--accent-text);
    font-variant-numeric: tabular-nums;
  }

  .dir__note {
    margin: 18px 0 0;
    color: var(--text-muted);
    max-width: 60ch;
    font-size: 15px;
  }
</style>
