---
import type { Reasons } from '../content/types';

interface Props {
  reasons: Reasons;
  tone: 'base' | 'alt';
}

const { reasons, tone } = Astro.props;
---

<section class={`section section--${tone}`} data-section="reasons">
  <div class="container stack">
    <p class="kicker kicker--problem">{reasons.kicker}</p>
    <h2 class="h2">{reasons.title}</h2>

    <div class="reasons__grid">
      {
        reasons.cards.map((card) => (
          <article class="rule-card rule-card--problem">
            <p class="reasons__num">{card.num}</p>
            <h3 class="reasons__title">{card.title}</h3>
            <p class="rule-card__text">{card.text}</p>
            <p class="reasons__solution">{card.solution}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .reasons__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 28px;
  }

  .reasons__num {
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 800;
    color: var(--accent-problem);
  }

  .reasons__title {
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 800;
    line-height: 1.1;
  }

  .reasons__solution {
    font-size: 16px;
    line-height: 1.5;
    color: var(--accent-text);
  }
</style>
