---
import { langFromUrl } from '../i18n';
import { useTranslations } from '../i18n/ui';
import { freeStepUrl } from '../lib/leadLink';
import { featuredTier } from '../lib/offer';

/**
 * Закреплённая панель внизу экрана — только на мобильном.
 *
 * До 60% глубины страницы показывает бесплатную ступень, после — подписку.
 * Логика та же, что и у правила размещения CTA: цену человек видит тогда,
 * когда уже прочитал, за что она.
 *
 * Пока ссылки оплаты нет, вторая кнопка не рендерится вовсе: подменять
 * бесплатный призыв на такой же бесплатный, но с другой подписью, — обман
 * ради анимации.
 */

interface Props {
  /** Сегмент страницы: едет с человеком до самого бота. */
  segment?: string;
}

const { segment } = Astro.props;

/* Язык берётся из адреса: панель стоит на каждой странице, и передавать его
   пропсом значило бы однажды забыть — на английской странице. */
const lang = langFromUrl(Astro.url);
const t = useTranslations(lang);

const featured = featuredTier(segment, lang);
const showSales = featured.hasCheckout;
---

<div class="sticky" data-sticky-cta hidden>
  <a class="sticky__btn sticky__btn--free" href={freeStepUrl(segment, lang)} data-cta="sticky_free" data-cta-kind="primary">
    {t('cta.free')}
  </a>

  {
    showSales && (
      <a
        class="sticky__btn sticky__btn--sales"
        href={featured.href}
        data-cta="sticky_sales"
        data-cta-kind="sales"
        hidden
      >
        {featured.ctaLabel}
      </a>
    )
  }
</div>

<style>
  .sticky {
    display: none;
  }

  @media (max-width: 719px) {
    .sticky {
      position: fixed;
      inset: auto 0 0 0;
      z-index: 30;
      display: block;
      padding: 12px 16px calc(12px + env(safe-area-inset-bottom));
      background: rgba(247, 242, 231, 0.94);
      border-top: 1px solid var(--border-hairline);
      backdrop-filter: blur(8px);
      /* Появляется только после первого экрана — там своя кнопка. */
      transform: translateY(110%);
      transition: transform 200ms ease;
    }

    .sticky--visible {
      transform: translateY(0);
    }

    .sticky__btn {
      display: block;
      width: 100%;
      padding: 16px 20px;
      font-family: var(--font-display);
      font-weight: 800;
      font-size: 17px;
      text-align: center;
      border-radius: var(--radius-button);
      background: var(--accent);
      color: var(--on-accent);
      /* Хит-таргет заведомо больше 44px. */
      min-height: 52px;
    }

    .sticky__btn[hidden] {
      display: none;
    }
  }
</style>

<script>
  import { track } from '../scripts/track';

  const panel = document.querySelector<HTMLElement>('[data-sticky-cta]');

  if (panel) {
    const free = panel.querySelector<HTMLElement>('.sticky__btn--free');
    const sales = panel.querySelector<HTMLElement>('.sticky__btn--sales');

    /** Доля прочитанного, после которой уместно показывать цену. */
    const SALES_THRESHOLD = 0.6;

    let salesShown = false;
    let visible = false;

    const update = () => {
      // Пока виден первый экран, в нём уже есть та же кнопка — не дублируем.
      const shouldShow = window.scrollY > window.innerHeight * 0.5;
      if (shouldShow !== visible) {
        visible = shouldShow;
        panel.classList.toggle('sticky--visible', shouldShow);
      }

      const scrollable = document.documentElement.scrollHeight - window.innerHeight;
      // Короткая страница целиком помещается в экран — считаем её прочитанной.
      const depth = scrollable > 0 ? window.scrollY / scrollable : 1;
      // Продажной кнопки может не быть вовсе — пока не заведена оплата.
      if (!sales) return;

      const showSales = depth >= SALES_THRESHOLD;

      if (showSales === salesShown) return;
      salesShown = showSales;

      free?.toggleAttribute('hidden', showSales);
      sales.toggleAttribute('hidden', !showSales);
    };

    panel.removeAttribute('hidden');
    update();

    let ticking = false;
    window.addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          update();
          ticking = false;
        });
      },
      { passive: true },
    );

    window.addEventListener('resize', update, { passive: true });

    sales?.addEventListener('click', () => track('checkout_started', { placement: 'sticky' }));
    free?.addEventListener('click', () => track('click_free_cta', { placement: 'sticky' }));
  }
</script>
