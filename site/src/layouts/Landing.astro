---
import '../styles/global.css';
import { site } from '../config/site';
import type { Meta } from '../content/types';

interface Props {
  meta: Meta;
  /** Путь страницы для canonical, например `/bez-boli/`. */
  path: string;
}

const { meta, path } = Astro.props;

const canonical = new URL(path, Astro.site);
const ogImage = new URL(meta.ogImage, Astro.site);

/**
 * Разметка организации и сайта.
 *
 * Нужна, чтобы поисковик связывал страницы между собой как один сайт, а не
 * как набор случайных документов. Ссылки на соцсети добавляются только
 * заполненные: пустой `sameAs` хуже отсутствующего.
 */
const socialLinks = [site.links.telegramChannel, site.links.youtube, site.links.instagram].filter(
  (link) => link.length > 0,
);

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.brand,
  url: new URL('/', Astro.site).href,
  ...(socialLinks.length > 0 ? { sameAs: socialLinks } : {}),
};

/**
 * Идентификатор контейнера подставляется внутрь строки скрипта, поэтому
 * пропускаем только безопасный набор символов: кавычка в конфиге иначе
 * разорвала бы код и превратила опечатку в дыру.
 */
const gtmId = /^[A-Za-z0-9_-]+$/.test(site.analytics.gtmId) ? site.analytics.gtmId : '';
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7f2e7" />

    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <link rel="canonical" href={canonical.href} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage.href} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <script type="application/ld+json" set:html={JSON.stringify(organization)} is:inline />

    {
      /* Контейнер аналитики. Пока идентификатор не задан, на страницу
         не попадает ни одного стороннего скрипта. */
      gtmId && (
        <script
          is:inline
          set:html={`(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','${gtmId}');`}
        />
      )
    }

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Onest:wght@400;500;700;800&family=Golos+Text:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <slot />
    <script>
      import '../scripts/analytics';
    </script>
  </body>
</html>
